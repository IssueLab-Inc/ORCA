# Local settings for the Sightline server. Copy to .env at the repo root (never committed), fill in what you need.
# Real environment variables win over this file. No quotes around values.

# Muse Spark on Meta's Model API: proposals, chat, plans, patterns, report text. Needed for anything that asks Muse Spark.
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_MODEL=muse-spark-1.3-contributor
# Reasoning effort: minimal | low | medium | high, or empty for the API's default.
META_REASONING_EFFORT=low

# Bulk triage on Muse Spark Open (Baseten). Without a key, triage uses Muse Spark above.
TRIAGE_API_KEY=
# TRIAGE_API_BASE_URL=https://inference.baseten.co/v1
# TRIAGE_MODEL=meta-models/muse-spark-open
# TRIAGE_REASONING_EFFORT=
# SIGHTLINE_TRIAGE_WORKERS=8

# Owner settings (gear in the header, open the page with #owner). At least 24 characters; make one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGHTLINE_OWNER_TOKEN=

# Demo caps: off when empty or 0 (the Modal deploy sets them).
# SIGHTLINE_PROPOSE_PER_HOUR=20
# SIGHTLINE_PROPOSE_PER_DAY=300
# SIGHTLINE_CHAT_PER_HOUR=40
# SIGHTLINE_CHAT_PER_DAY=1500
# SIGHTLINE_VOICE_PER_HOUR=60
# SIGHTLINE_VOICE_PER_DAY=2000
